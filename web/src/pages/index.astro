---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

interface ChildProfile {
  child: {
    name: string;
    gender: string;
    birthDate: string;
    city: string;
    personality?: {
      temperament?: string;
      interests?: string[];
      description?: string;
    };
    developmentNotes?: string;
  };
  health?: {
    allergies?: string[];
    sleepPattern?: { bedtime: string; wakeup: string; nap: string };
    diet?: { preferences?: string[]; challenges?: string[] };
    notes?: string;
  };
  school?: {
    type: string;
    schedule: string;
    notes: string;
  };
  siblings?: string[];
  languageEnv?: string[];
  family?: {
    primaryCaregiver?: string;
    caregivers?: { role: string; time?: string; notes?: string; style?: string; relationship?: string }[];
    parentingStyle?: string;
    notes?: string;
  };
  strategyResponse?: { strategy?: string; type?: string; rating: number; notes?: string; evidence?: string; evaluatedAt?: string }[];
  behaviorPatterns?: { topic: string; pattern: string; observedAt: string }[];
  currentConcerns?: string[];
  parentingPhilosophy?: { preferredApproach?: string; booksReading?: string[] };
  lastUpdated?: string;
}

const profilePath = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../../data/child-profile.json');
let profile: ChildProfile | null = null;
try {
  const raw = fs.readFileSync(profilePath, 'utf-8');
  profile = JSON.parse(raw);
} catch {}

const isEmpty = !profile || !profile.child.name;

function getAge(birthDate: string): string {
  if (!birthDate) return '';
  const birth = new Date(birthDate);
  const now = new Date();
  const months = (now.getFullYear() - birth.getFullYear()) * 12 + now.getMonth() - birth.getMonth();
  const years = Math.floor(months / 12);
  const remainingMonths = months % 12;
  if (years > 0) return `${years}岁${remainingMonths > 0 ? remainingMonths + '个月' : ''}`;
  return `${months}个月`;
}

function getStars(rating: number): string {
  return '★'.repeat(rating) + '☆'.repeat(5 - rating);
}

const nonEmpty = (arr: string[] | undefined): arr is string[] => Array.isArray(arr) && arr.length > 0;
---

<BaseLayout title="孩子档案" currentPath="/">
  {isEmpty ? (
    <!-- Empty state -->
    <div class="text-center py-20">
      <div class="w-20 h-20 mx-auto mb-6 bg-[#8D6E63]/10 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#8D6E63" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9 12h.01"/><path d="M15 12h.01"/>
          <path d="M8 16c1.5 1 3 1 4 1s2.5 0 4-1"/>
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-gray-800 mb-3">开始使用育儿顾问</h1>
      <p class="text-gray-500 max-w-md mx-auto mb-8">
        在项目目录下打开 Claude Code，输入 <code class="px-2 py-1 bg-stone-200 rounded text-sm font-mono">/yuer</code> 开始第一次对话。<br/>
        AI 会通过聊天了解你的孩子，自动建立档案。
      </p>
      <div class="inline-block text-left bg-white rounded-xl p-6 shadow-sm border border-stone-200 max-w-sm">
        <h2 class="font-semibold mb-3 text-sm text-gray-700">快速开始</h2>
        <ol class="space-y-2 text-sm text-gray-600">
          <li class="flex gap-2"><span class="font-mono text-[#8D6E63]">1.</span> 在项目根目录打开终端</li>
          <li class="flex gap-2"><span class="font-mono text-[#8D6E63]">2.</span> 运行 <code class="px-1.5 py-0.5 bg-stone-100 rounded text-xs font-mono">claude</code></li>
          <li class="flex gap-2"><span class="font-mono text-[#8D6E63]">3.</span> 输入 <code class="px-1.5 py-0.5 bg-stone-100 rounded text-xs font-mono">/yuer</code></li>
          <li class="flex gap-2"><span class="font-mono text-[#8D6E63]">4.</span> 开始聊天，AI 自动建档</li>
        </ol>
      </div>
    </div>
  ) : (
    <div class="space-y-5">
      <!-- Header -->
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 bg-[#8D6E63] rounded-full flex items-center justify-center text-white text-2xl font-bold">
          {profile!.child.name.charAt(0)}
        </div>
        <div>
          <h1 class="text-2xl font-bold">{profile!.child.name}</h1>
          <p class="text-gray-500 text-sm">
            {profile!.child.gender === '男' ? '男孩' : profile!.child.gender === '女' ? '女孩' : profile!.child.gender}
            {profile!.child.birthDate ? ` · ${getAge(profile!.child.birthDate)}` : ''}
            {profile!.child.city ? ` · ${profile!.child.city}` : ''}
          </p>
        </div>
      </div>

      <!-- School & Language row -->
      {(profile!.school?.type || nonEmpty(profile!.languageEnv) || nonEmpty(profile!.siblings)) && (
        <div class="bg-white rounded-xl p-5 shadow-sm border border-stone-200">
          <div class="space-y-3">
            {profile!.school?.type && (
              <div class="flex items-start gap-3">
                <span class="text-sm text-gray-500 w-20 shrink-0">托班/园所</span>
                <span class="text-sm text-gray-800">{profile!.school.type}{profile!.school.schedule ? `（${profile!.school.schedule}）` : ''}</span>
              </div>
            )}
            {nonEmpty(profile!.languageEnv) && (
              <div class="flex items-start gap-3">
                <span class="text-sm text-gray-500 w-20 shrink-0">语言环境</span>
                <div class="flex flex-wrap gap-1.5">
                  {profile!.languageEnv!.map((lang: string) => (
                    <span class="text-sm bg-blue-50 text-blue-700 px-2 py-0.5 rounded">{lang}</span>
                  ))}
                </div>
              </div>
            )}
            {nonEmpty(profile!.siblings) && (
              <div class="flex items-start gap-3">
                <span class="text-sm text-gray-500 w-20 shrink-0">兄弟姐妹</span>
                <span class="text-sm text-gray-800">{profile!.siblings!.join('、')}</span>
              </div>
            )}
          </div>
        </div>
      )}

      <!-- Health -->
      {(nonEmpty(profile!.health?.allergies) || profile!.health?.sleepPattern?.bedtime || nonEmpty(profile!.health?.diet?.challenges) || profile!.health?.notes) && (
        <div class="bg-white rounded-xl p-5 shadow-sm border border-stone-200">
          <h2 class="font-semibold text-gray-800 mb-3">健康信息</h2>
          <div class="space-y-3">
            {nonEmpty(profile!.health!.allergies) && (
              <div class="flex items-start gap-3">
                <span class="text-sm text-red-500 w-20 shrink-0 font-medium">过敏/禁忌</span>
                <div class="flex flex-wrap gap-1.5">
                  {profile!.health!.allergies!.map((a: string) => (
                    <span class="text-sm bg-red-50 text-red-700 px-2 py-0.5 rounded">{a}</span>
                  ))}
                </div>
              </div>
            )}
            {profile!.health!.sleepPattern?.bedtime && (
              <div class="flex items-start gap-3">
                <span class="text-sm text-gray-500 w-20 shrink-0">睡眠</span>
                <span class="text-sm text-gray-700">
                  {profile!.health!.sleepPattern.bedtime} 睡 → {profile!.health!.sleepPattern.wakeup} 起
                  {profile!.health!.sleepPattern.nap ? ` · 午觉 ${profile!.health!.sleepPattern.nap}` : ''}
                </span>
              </div>
            )}
            {nonEmpty(profile!.health!.diet?.challenges) && (
              <div class="flex items-start gap-3">
                <span class="text-sm text-gray-500 w-20 shrink-0">饮食挑战</span>
                <div class="flex flex-wrap gap-1.5">
                  {profile!.health!.diet!.challenges!.map((c: string) => (
                    <span class="text-sm bg-amber-50 text-amber-700 px-2 py-0.5 rounded">{c}</span>
                  ))}
                </div>
              </div>
            )}
            {profile!.health!.notes && (
              <p class="text-sm text-gray-600 pl-[5.25rem]">{profile!.health!.notes}</p>
            )}
          </div>
        </div>
      )}

      <!-- Current concerns -->
      {nonEmpty(profile!.currentConcerns) && (
        <div class="bg-white rounded-xl p-5 shadow-sm border border-stone-200">
          <h2 class="font-semibold text-gray-800 mb-3">当前关注</h2>
          <ul class="space-y-2">
            {profile!.currentConcerns!.map((concern: string) => (
              <li class="flex items-start gap-2 text-sm text-gray-700">
                <span class="mt-1.5 w-1.5 h-1.5 bg-amber-400 rounded-full shrink-0"></span>
                {concern}
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Personality & Interests -->
      {(profile!.child.personality?.temperament || nonEmpty(profile!.child.personality?.interests) || profile!.child.personality?.description) && (
        <div class="bg-white rounded-xl p-5 shadow-sm border border-stone-200">
          <h2 class="font-semibold text-gray-800 mb-3">气质与兴趣</h2>
          <div class="space-y-3">
            {profile!.child.personality!.temperament && (
              <p class="text-sm text-gray-700">{profile!.child.personality!.temperament}</p>
            )}
            {nonEmpty(profile!.child.personality!.interests) && (
              <div class="flex flex-wrap gap-2">
                {profile!.child.personality!.interests!.map((interest: string) => (
                  <span class="text-sm bg-[#8D6E63]/10 text-[#5D4037] px-3 py-1.5 rounded-lg">{interest}</span>
                ))}
              </div>
            )}
            {profile!.child.personality!.description && (
              <p class="text-sm text-gray-500">{profile!.child.personality!.description}</p>
            )}
          </div>
        </div>
      )}

      <!-- Family -->
      {(profile!.family?.primaryCaregiver || nonEmpty(profile!.family?.caregivers)) && (
        <div class="bg-white rounded-xl p-5 shadow-sm border border-stone-200">
          <h2 class="font-semibold text-gray-800 mb-3">家庭照顾者</h2>
          <div class="space-y-3">
            {profile!.family!.primaryCaregiver && (
              <p class="text-sm text-gray-500">主要照顾者：{profile!.family!.primaryCaregiver}</p>
            )}
            {profile!.family!.caregivers && profile!.family!.caregivers.map((c) => (
              <div class="flex items-start gap-3">
                <span class="text-sm font-medium text-gray-800 w-16 shrink-0">{c.role}</span>
                <div class="text-sm text-gray-600">
                  {c.time && <span class="text-gray-400">{c.time} · </span>}
                  {c.notes || c.style || ''}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Strategy response -->
      {nonEmpty(profile!.strategyResponse) && (
        <div class="bg-white rounded-xl p-5 shadow-sm border border-stone-200">
          <h2 class="font-semibold text-gray-800 mb-3">策略响应模式</h2>
          <div class="space-y-3">
            {profile!.strategyResponse!
              .sort((a, b) => b.rating - a.rating)
              .map(s => (
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-700">{s.strategy || s.type}</span>
                  <span class="text-amber-500 text-sm tracking-wider">{getStars(s.rating)}</span>
                </div>
                {(s.notes || s.evidence) && (
                  <p class="text-xs text-gray-400 mt-1">{s.notes || s.evidence}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Behavior patterns -->
      {nonEmpty(profile!.behaviorPatterns) && (
        <div class="bg-white rounded-xl p-5 shadow-sm border border-stone-200">
          <h2 class="font-semibold text-gray-800 mb-3">行为模式</h2>
          <div class="space-y-3">
            {profile!.behaviorPatterns!.map((bp) => (
              <div>
                <span class="text-sm font-medium text-gray-700">{bp.topic}</span>
                <p class="text-sm text-gray-600 mt-0.5">{bp.pattern}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Parenting philosophy -->
      {profile!.parentingPhilosophy && (profile!.parentingPhilosophy.preferredApproach || nonEmpty(profile!.parentingPhilosophy.booksReading)) && (
        <div class="bg-white rounded-xl p-5 shadow-sm border border-stone-200">
          <h2 class="font-semibold text-gray-800 mb-3">教育理念</h2>
          <div class="space-y-2 text-sm text-gray-700">
            {profile!.parentingPhilosophy.preferredApproach && <p>{profile!.parentingPhilosophy.preferredApproach}</p>}
            {nonEmpty(profile!.parentingPhilosophy.booksReading) && (
              <div class="flex flex-wrap gap-2 mt-2">
                {profile!.parentingPhilosophy.booksReading!.map((book: string) => (
                  <span class="bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-lg text-xs">{book}</span>
                ))}
              </div>
            )}
          </div>
        </div>
      )}

      <!-- Development notes (fallback when no structured data) -->
      {profile!.child.developmentNotes && (
        <div class="bg-white rounded-xl p-5 shadow-sm border border-stone-200">
          <h2 class="font-semibold text-gray-800 mb-3">发展观察</h2>
          <p class="text-sm text-gray-700">{profile!.child.developmentNotes}</p>
        </div>
      )}

      <!-- Last updated -->
      {profile!.lastUpdated && (
        <p class="text-xs text-gray-400 text-center">最后更新：{profile!.lastUpdated}</p>
      )}
    </div>
  )}
</BaseLayout>
