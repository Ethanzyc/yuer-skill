---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

interface TrackingRecord {
  id: string;
  date: string;
  problem: string;
  level: string;
  strategy: string;
  source: string;
  difficulty: string;
  expectedTimeline: string;
  status: string;
  outcome?: string;
  childReaction?: string;
  parentFeedback?: string;
}

interface FollowUp {
  id: string;
  date: string;
  problem: string;
  followUpQuestion: string;
  status: string;
}

interface StrategySummary {
  type: string;
  uses: number;
  effective: number;
  partial: number;
  ineffective: number;
}

interface AdviceTracking {
  strategySummary: StrategySummary[];
  records: TrackingRecord[];
  followUps: FollowUp[];
}

const trackingPath = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../../data/advice-tracking.json');
let tracking: AdviceTracking = { strategySummary: [], records: [], followUps: [] };
try {
  const raw = fs.readFileSync(trackingPath, 'utf-8');
  tracking = JSON.parse(raw);
} catch {}

const isEmpty = tracking.records.length === 0 && tracking.followUps.length === 0;

const statusConfig: Record<string, { label: string; color: string }> = {
  pending: { label: '待跟进', color: 'bg-amber-100 text-amber-700' },
  'in-progress': { label: '进行中', color: 'bg-blue-100 text-blue-700' },
  resolved: { label: '已解决', color: 'bg-green-100 text-green-700' },
  completed: { label: '已完成', color: 'bg-green-100 text-green-700' },
};

const levelConfig: Record<string, { label: string; color: string }> = {
  L1: { label: 'L1', color: 'bg-red-100 text-red-700' },
  L2: { label: 'L2', color: 'bg-amber-100 text-amber-700' },
  L3: { label: 'L3', color: 'bg-blue-100 text-blue-700' },
};

const pendingFollowUps = tracking.followUps?.filter(f => f.status === 'pending') || [];
const sortedRecords = [...(tracking.records || [])].sort((a, b) =>
  new Date(b.date).getTime() - new Date(a.date).getTime()
);

function getMaxUses(summary: StrategySummary[]): number {
  return Math.max(...summary.map(s => s.uses), 1);
}
---

<BaseLayout title="问题追踪" currentPath="/tracking">
  {isEmpty ? (
    <div class="text-center py-20">
      <div class="w-20 h-20 mx-auto mb-6 bg-[#8D6E63]/10 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#8D6E63" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-gray-800 mb-3">问题追踪</h1>
      <p class="text-gray-500">还没有追踪记录。使用 <code class="px-1.5 py-0.5 bg-stone-100 rounded text-xs font-mono">/yuer-ask</code> 提问，L2/L3 问题的建议会自动追踪。</p>
    </div>
  ) : (
    <div class="space-y-6">
      <h1 class="text-2xl font-bold">问题追踪</h1>

      <!-- Pending follow-ups -->
      {pendingFollowUps.length > 0 && (
        <div class="bg-amber-50 rounded-xl p-5 border border-amber-200">
          <h2 class="font-semibold text-amber-800 mb-3">待跟进 ({pendingFollowUps.length})</h2>
          <div class="space-y-3">
            {pendingFollowUps.map(fu => (
              <div class="bg-white rounded-lg p-3 border border-amber-100">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-medium text-gray-800">{fu.problem}</span>
                  <span class="text-xs text-gray-400">{fu.date}</span>
                </div>
                <p class="text-sm text-gray-600">{fu.followUpQuestion}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Strategy effectiveness -->
      {tracking.strategySummary && tracking.strategySummary.length > 0 && (
        <div class="bg-white rounded-xl p-5 shadow-sm border border-stone-200">
          <h2 class="font-semibold text-gray-800 mb-4">策略效果汇总</h2>
          <div class="space-y-3">
            {tracking.strategySummary.map(s => {
              const maxBar = getMaxUses(tracking.strategySummary);
              const total = s.effective + s.partial + s.ineffective;
              return (
                <div>
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-sm text-gray-700">{s.type}</span>
                    <span class="text-xs text-gray-400">使用 {s.uses} 次</span>
                  </div>
                  <div class="flex h-3 rounded-full overflow-hidden bg-gray-100">
                    {s.effective > 0 && (
                      <div class="bg-green-500" style={`width: ${(s.effective / maxBar) * 100}%`}></div>
                    )}
                    {s.partial > 0 && (
                      <div class="bg-amber-400" style={`width: ${(s.partial / maxBar) * 100}%`}></div>
                    )}
                    {s.ineffective > 0 && (
                      <div class="bg-red-400" style={`width: ${(s.ineffective / maxBar) * 100}%`}></div>
                    )}
                  </div>
                  {total > 0 && (
                    <div class="flex gap-3 mt-1 text-xs text-gray-400">
                      <span class="text-green-600">有效 {s.effective}</span>
                      <span class="text-amber-600">部分 {s.partial}</span>
                      <span class="text-red-600">无效 {s.ineffective}</span>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- Advice history -->
      {sortedRecords.length > 0 && (
        <div class="bg-white rounded-xl p-5 shadow-sm border border-stone-200">
          <h2 class="font-semibold text-gray-800 mb-4">建议历史</h2>
          <div class="space-y-4">
            {sortedRecords.map(record => {
              const sc = statusConfig[record.status] || statusConfig.pending;
              const lc = levelConfig[record.level] || levelConfig.L1;
              return (
                <div class="border-b border-stone-100 pb-4 last:border-0 last:pb-0">
                  <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-2">
                      <span class={`text-xs px-2 py-0.5 rounded-full ${lc.color}`}>{lc.label}</span>
                      <span class="text-sm font-medium text-gray-800">{record.problem}</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-xs text-gray-400">{record.date}</span>
                      <span class={`text-xs px-2 py-0.5 rounded-full ${sc.color}`}>{sc.label}</span>
                    </div>
                  </div>
                  <div class="text-sm text-gray-600 space-y-1 ml-1">
                    <p>策略：<span class="text-gray-800">{record.strategy}</span></p>
                    {record.source && <p class="text-gray-400">来源：{record.source}</p>}
                    {record.difficulty && <p class="text-gray-400">难度：{record.difficulty}</p>}
                    {record.expectedTimeline && <p class="text-gray-400">预期见效：{record.expectedTimeline}</p>}
                    {record.outcome && <p class="text-green-700">结果：{record.outcome}</p>}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  )}
</BaseLayout>
