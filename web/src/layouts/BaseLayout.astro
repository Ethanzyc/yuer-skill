---
import '../styles/global.css';

interface Props {
  title?: string;
  currentPath?: string;
}

const { title = '育儿顾问', currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', label: '档案', icon: 'baby' },
  { href: '/problems', label: '问题速查', icon: 'search' },
  { href: '/tracking', label: '追踪', icon: 'chart' },
];

function isActive(href: string, current: string): boolean {
  if (href === '/') return current === '/';
  return current.startsWith(href);
}

function getIcon(name: string): string {
  const icons: Record<string, string> = {
    baby: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9 12h.01"/><path d="M15 12h.01"/><path d="M8 16c1.5 1 3 1 4 1s2.5 0 4-1"/></svg>',
    search: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>',
    chart: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>',
  };
  return icons[name] || '';
}
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="个性化育儿顾问" />
    <title>{title}</title>
  </head>
  <body class="bg-[#EFE9E1] text-gray-900 min-h-screen">
    <!-- Desktop sidebar -->
    <aside class="hidden md:flex md:flex-col md:fixed md:inset-y-0 md:left-0 md:w-52 lg:w-56 bg-[#5D4037] text-white z-30">
      <div class="px-4 py-5 font-bold text-lg border-b border-white/10">
        育儿顾问
      </div>
      <nav class="flex-1 px-2 py-3 space-y-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[
              'flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-colors',
              isActive(item.href, currentPath)
                ? 'bg-white/20 font-medium'
                : 'text-amber-100 hover:bg-white/10',
            ]}
          >
            <Fragment set:html={getIcon(item.icon)} />
            {item.label}
          </a>
        ))}
      </nav>
    </aside>

    <!-- Main content -->
    <main class="md:ml-52 lg:ml-56 min-h-screen pb-20 md:pb-0">
      <div class="max-w-4xl mx-auto px-4 py-6">
        <slot />
      </div>
    </main>

    <!-- Mobile bottom tab bar -->
    <nav class="fixed bottom-0 inset-x-0 md:hidden bg-white border-t border-stone-200 z-30">
      <div class="flex">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[
              'flex-1 flex flex-col items-center py-2 text-xs transition-colors',
              isActive(item.href, currentPath)
                ? 'text-[#8D6E63] font-semibold'
                : 'text-gray-500',
            ]}
          >
            <Fragment set:html={getIcon(item.icon)} />
            <span class="mt-0.5">{item.label}</span>
          </a>
        ))}
      </div>
    </nav>
  </body>
</html>
